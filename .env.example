APP_NAME="KassirON"
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_DEFAULT_LANG=uz

DB_PATH=database/kassiron.db

SUPER_ADMIN_LOGIN=admin
SUPER_ADMIN_PASSWORD=change-me-please

# Telegram bot (ixtiyoriy) — @BotFather orqali yarating
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram orqali kirish / ro'yxatdan o'tish ham shu bot bilan ishlaydi:
# @BotFather → /setdomain → saytingiz domeni (masalan kassiron.uz).

# Google bilan kirish (ixtiyoriy): console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID (Web application). Authorised redirect URI:
# <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
